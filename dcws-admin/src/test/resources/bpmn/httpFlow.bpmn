    <bpmn:process id="save_money" isClosed="false" isExecutable="true" name="save_money" processType="None">
        <bpmn:documentation id="save_money_D_1"><![CDATA[存钱]]></bpmn:documentation>
        <bpmn:startEvent id="httpFlow" name="httpFlow">
            <bpmn:documentation id="httpFlow_D_1"><![CDATA[httpFlow请求]]></bpmn:documentation>
            <bpmn:extensionElements>
                <bpmn:camunda:properties>
                    <bpmn:camunda:property name="idempotent" value="true"/>
                    <bpmn:camunda:property name="idempotent-keys" value="[&quot;data.id&quot;,&quot;data.name&quot;]"/>
                    <bpmn:camunda:property name="transactional-suspend" value="false"/>
                </bpmn:camunda:properties>
            </bpmn:extensionElements>
        </bpmn:startEvent>
        <bpmn:serviceTask activiti:exclusive="true" id="verify" name="verify">
            <bpmn:documentation id="verify_D_1"><![CDATA[验证用户名密码]]></bpmn:documentation>
            <bpmn:extensionElements>
                <bpmn:camunda:properties>
                    <bpmn:camunda:property name="task-service" value="rest-service"/>
                    <bpmn:camunda:property name="task-component" value="KstryFlowService"/>
                    <bpmn:camunda:property name="task-params" value="{&#10;    &quot;request&quot;: {&#10;        &quot;url&quot;: &quot;http://localhost:8888/user/verify&quot;,&#10;        &quot;method&quot;: &quot;POST&quot;,&#10;        &quot;body&quot;: {&#10;            &quot;name&quot;: &quot;@req.data.name&quot;,&#10;            &quot;pwd&quot;: &quot;123&quot;&#10;        }&#10;    },&#10;    &quot;config&quot;: {&#10;        &quot;id&quot;: &quot;verify&quot;,&#10;        &quot;transactional&quot;: false,&#10;        &quot;transactional-red&quot;: false&#10;    }&#10;}"/>
                </bpmn:camunda:properties>
            </bpmn:extensionElements>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_0vq2psv" sourceRef="httpFlow" targetRef="verify"/>
        <bpmn:sequenceFlow id="Flow_1o4mfnu" sourceRef="verify" targetRef="asyncGateway"/>
        <bpmn:inclusiveGateway gatewayDirection="Unspecified" id="asyncGateway" name="asyncGateway">
            <bpmn:documentation id="asyncGateway_D_1"><![CDATA[并行网关
]]></bpmn:documentation>
            <bpmn:extensionElements>
                <bpmn:camunda:properties>
                    <bpmn:camunda:property name="open-async" value="true"/>
                    <bpmn:camunda:property name="midway-start-id" value="midway-001"/>
                </bpmn:camunda:properties>
            </bpmn:extensionElements>
        </bpmn:inclusiveGateway>
        <bpmn:subProcess activiti:exclusive="true" id="sub_user_info" name="sub_user_info" triggeredByEvent="false">
            <bpmn:documentation id="sub_user_info_D_1"><![CDATA[用户信息 子流程]]></bpmn:documentation>
            <bpmn:startEvent id="Event_1sq263k" name="user_info">
                <bpmn:documentation id="Event_1sq263k_D_1"><![CDATA[用户信息子流程]]></bpmn:documentation>
            </bpmn:startEvent>
            <bpmn:serviceTask activiti:exclusive="true" id="isAdmin" name="isAdmin">
                <bpmn:documentation id="isAdmin_D_1"><![CDATA[判断是否是管理员用户]]></bpmn:documentation>
                <bpmn:extensionElements>
                    <bpmn:camunda:properties>
                        <bpmn:camunda:property name="task-service" value="rest-service"/>
                        <bpmn:camunda:property name="task-params" value="{&#10;    &quot;request&quot;: {&#10;        &quot;url&quot;: &quot;http://localhost:8888/user/isAdmin&quot;,&#10;        &quot;method&quot;: &quot;GET&quot;,&#10;        &quot;params&quot;: {&#10;            &quot;id&quot;: &quot;@var.verify.response.data.id&quot;&#10;        }&#10;    },&#10;    &quot;config&quot;: {&#10;        &quot;id&quot;: &quot;isAdmin&quot;&#10;    }&#10;}"/>
                        <bpmn:camunda:property name="task-component" value="KstryFlowService"/>
                    </bpmn:camunda:properties>
