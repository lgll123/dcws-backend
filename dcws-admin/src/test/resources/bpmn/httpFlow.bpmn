            <bpmn:sequenceFlow id="Flow_1bhfb73" sourceRef="login" targetRef="getBalance"/>
            <bpmn:sequenceFlow id="Flow_1rxsr4o" sourceRef="cost_gateway" targetRef="cost">
                <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[var.balance>0]]></bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Flow_1518o56" sourceRef="cost_gateway" targetRef="deposit">
                <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[var.balance<=0]]></bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Flow_0j5z51w" sourceRef="getBalance" targetRef="cost_gateway">
                <bpmn:documentation id="Flow_0j5z51w_D_1"><![CDATA[余额是否大于0]]></bpmn:documentation>
            </bpmn:sequenceFlow>
            <bpmn:inclusiveGateway gatewayDirection="Unspecified" id="cost_gateway" name="cost_gateway"/>
            <bpmn:sequenceFlow id="Flow_0k4qw6w" sourceRef="cost" targetRef="Event_1t5zntg"/>
            <bpmn:sequenceFlow id="Flow_0td8u1s" sourceRef="deposit" targetRef="Event_1t5zntg"/>
