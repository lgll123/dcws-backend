                <bpmn:documentation id="account_D_1"><![CDATA[账户操作 子流程
]]></bpmn:documentation>
            </bpmn:startEvent>
            <bpmn:serviceTask activiti:exclusive="true" id="login" name="login">
                <bpmn:documentation id="login_D_1"><![CDATA[登录换取token
]]></bpmn:documentation>
                <bpmn:extensionElements>
                    <bpmn:camunda:properties>
                        <bpmn:camunda:property name="task-service" value="rest-service"/>
                        <bpmn:camunda:property name="task-params" value="{&#10;    &quot;request&quot;: {&#10;        &quot;url&quot;: &quot;http://localhost:8888/userAccount/login&quot;,&#10;        &quot;method&quot;: &quot;POST&quot;,&#10;        &quot;body&quot;: {&#10;            &quot;name&quot;: &quot;@req.data.name&quot;,&#10;            &quot;pwd&quot;: &quot;@req.data.pwd&quot;&#10;        }&#10;    },&#10;    &quot;config&quot;: {&#10;        &quot;id&quot;: &quot;login&quot;,&#10;    }&#10;}"/>
