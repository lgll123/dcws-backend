            <bpmn:serviceTask activiti:exclusive="true" id="getBalance" name="getBalance">
                <bpmn:documentation id="getBalance_D_1"><![CDATA[通过token在行方接口获取余额]]></bpmn:documentation>
                <bpmn:extensionElements>
                    <bpmn:camunda:properties>
                        <bpmn:camunda:property name="task-params" value="{&#10;    &quot;request&quot;: {&#10;        &quot;url&quot;: &quot;http://localhost:8888/userAccount/getBalance&quot;,&#10;        &quot;method&quot;: &quot;GET&quot;,&#10;        &quot;params&quot;: {&#10;            &quot;userId&quot;: &quot;@var.verify.response.data.id&quot;&#10;        }&#10;    },&#10;    &quot;config&quot;: {&#10;        &quot;id&quot;: &quot;getBalance&quot;,&#10;    }&#10;}"/>
