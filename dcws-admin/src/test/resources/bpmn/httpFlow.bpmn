                </bpmn:extensionElements>
            </bpmn:serviceTask>
            <bpmn:serviceTask activiti:exclusive="true" id="cost" name="cost">
                <bpmn:documentation id="cost_D_1"><![CDATA[消费金额]]></bpmn:documentation>
                <bpmn:extensionElements>
                    <bpmn:camunda:properties>
                        <bpmn:camunda:property name="task-params" value="{&#10;    &quot;request&quot;: {&#10;        &quot;url&quot;: &quot;http://localhost:8888/userAccount/cost&quot;,&#10;        &quot;method&quot;: &quot;POST&quot;,&#10;        &quot;body&quot;: {&#10;            &quot;userId&quot;: &quot;@var.verify.response.data.id&quot;,&#10;            &quot;consumptionAmount&quot;:&quot;@req.data.consumptionAmount&quot;&#10;        }&#10;    },&#10;    &quot;config&quot;: {&#10;        &quot;id&quot;: &quot;cost&quot;&#10;    }&#10;}"/>
                        <bpmn:camunda:property name="task-service" value="rest-service"/>
                        <bpmn:camunda:property name="task-component" value="KstryFlowService"/>
                    </bpmn:camunda:properties>
