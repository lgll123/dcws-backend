<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_0001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="save_money" name="save_money" isExecutable="true">
    <bpmn:documentation>存钱</bpmn:documentation>
    <bpmn:startEvent id="performance" name="performance">
      <bpmn:documentation>复杂流程实现</bpmn:documentation>
      <bpmn:outgoing>Flow_0vq2psv</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="verify" name="verify">
      <bpmn:documentation>验证用户名密码</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="task-service" value="verify" />
          <camunda:property name="task-component" value="ComplexityComponent" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vq2psv</bpmn:incoming>
      <bpmn:outgoing>Flow_1o4mfnu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0vq2psv" sourceRef="performance" targetRef="verify" />
    <bpmn:sequenceFlow id="Flow_1o4mfnu" sourceRef="verify" targetRef="asyncGateway" />
    <bpmn:inclusiveGateway id="asyncGateway" name="asyncGateway">
      <bpmn:documentation>并行网关
</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="open-async" value="true" />
          <camunda:property name="midway-start-id" value="midway-001" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1o4mfnu</bpmn:incoming>
      <bpmn:outgoing>Flow_1bml744</bpmn:outgoing>
      <bpmn:outgoing>Flow_1pj3bp4</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:subProcess id="sub_user_info" name="sub_user_info">
      <bpmn:documentation>用户信息 子流程</bpmn:documentation>
      <bpmn:startEvent id="Event_1sq263k" name="user_info">
        <bpmn:documentation>用户信息子流程</bpmn:documentation>
        <bpmn:outgoing>Flow_0q97q85</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="is_admin" name="is_admin">
        <bpmn:documentation>判断是否是管理员用户</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="task-service" value="is_admin" />
            <camunda:property name="task-component" value="ComplexityComponent" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0q97q85</bpmn:incoming>
        <bpmn:outgoing>Flow_0vkipnp</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="user_list" name="user_list">
        <bpmn:documentation>返回用户信息</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="task-service" value="user_list" />
            <camunda:property name="task-component" value="ComplexityComponent" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_06cg7cq</bpmn:incoming>
        <bpmn:outgoing>Flow_0z4oiam</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="isAdminGateway" name="isAdminGateway">
        <bpmn:documentation>判断是否管理员的网关</bpmn:documentation>
        <bpmn:incoming>Flow_0vkipnp</bpmn:incoming>
        <bpmn:outgoing>Flow_0e7xxn5</bpmn:outgoing>
        <bpmn:outgoing>Flow_06cg7cq</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="user_info" name="user_info">
        <bpmn:documentation>返回用户信息</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="task-service" value="user_info" />
            <camunda:property name="task-component" value="ComplexityComponent" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0e7xxn5</bpmn:incoming>
        <bpmn:outgoing>Flow_1138ir5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_06cg7cq" sourceRef="isAdminGateway" targetRef="user_list">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">var.isAdmin==true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0e7xxn5" sourceRef="isAdminGateway" targetRef="user_info">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">var.isAdmin==false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0q97q85" sourceRef="Event_1sq263k" targetRef="is_admin" />
      <bpmn:sequenceFlow id="Flow_0vkipnp" sourceRef="is_admin" targetRef="isAdminGateway" />
      <bpmn:endEvent id="Event_1820r37" name="end">
        <bpmn:documentation>sub_user_info 结束</bpmn:documentation>
        <bpmn:incoming>Flow_1138ir5</bpmn:incoming>
        <bpmn:incoming>Flow_0z4oiam</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1138ir5" sourceRef="user_info" targetRef="Event_1820r37" />
      <bpmn:sequenceFlow id="Flow_0z4oiam" sourceRef="user_list" targetRef="Event_1820r37" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_12l92gd" sourceRef="response" targetRef="end" />
    <bpmn:serviceTask id="response" name="response">
      <bpmn:documentation>获取响应结果</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="task-service" value="response" />
          <camunda:property name="task-component" value="ComplexityComponent" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ebo0cw</bpmn:incoming>
      <bpmn:incoming>Flow_11akgq2</bpmn:incoming>
      <bpmn:outgoing>Flow_12l92gd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="end">
      <bpmn:documentation>结束</bpmn:documentation>
      <bpmn:incoming>Flow_12l92gd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="call_sub_user_info" name="sub_user_info" calledElement="sub_user_info">
      <bpmn:documentation>用户信息 子流程</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="timeout" value="2000" />
          <camunda:property name="strict-mode" value="true" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bml744</bpmn:incoming>
      <bpmn:outgoing>Flow_1ebo0cw</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1ebo0cw" sourceRef="call_sub_user_info" targetRef="response" />
    <bpmn:sequenceFlow id="Flow_1bml744" sourceRef="asyncGateway" targetRef="call_sub_user_info" />
    <bpmn:subProcess id="sub_account" name="sub_account">
      <bpmn:documentation>账户操作 子流程
</bpmn:documentation>
      <bpmn:startEvent id="account" name="account">
        <bpmn:documentation>账户操作 子流程
</bpmn:documentation>
        <bpmn:outgoing>Flow_1g5yro7</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="login" name="login">
        <bpmn:documentation>登录换取token
</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="task-service" value="login" />
            <camunda:property name="task-component" value="ComplexityComponent" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1g5yro7</bpmn:incoming>
        <bpmn:outgoing>Flow_1bhfb73</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="cost" name="cost">
        <bpmn:documentation>消费金额</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="task-service" value="cost" />
            <camunda:property name="task-component" value="ComplexityComponent" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1rxsr4o</bpmn:incoming>
        <bpmn:outgoing>Flow_1rwqr7k</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="deposit" name="deposit">
        <bpmn:documentation>存钱</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="task-service" value="deposit" />
            <camunda:property name="task-component" value="ComplexityComponent" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1518o56</bpmn:incoming>
        <bpmn:outgoing>Flow_195m52i</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_1g5yro7" sourceRef="account" targetRef="login" />
      <bpmn:endEvent id="Event_1t5zntg" name="end">
        <bpmn:documentation>sub_user_info 结束</bpmn:documentation>
        <bpmn:incoming>Flow_1fix1zc</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="get_balance" name="get_balance">
        <bpmn:documentation>通过token在行方接口获取余额</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="task-service" value="get_balance" />
            <camunda:property name="task-component" value="ComplexityComponent" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1bhfb73</bpmn:incoming>
        <bpmn:outgoing>Flow_0j5z51w</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_1bhfb73" sourceRef="login" targetRef="get_balance" />
      <bpmn:sequenceFlow id="Flow_1rxsr4o" sourceRef="cost_gateway" targetRef="cost">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">var.balance&gt;0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1518o56" sourceRef="cost_gateway" targetRef="deposit">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">var.balance&lt;=0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0j5z51w" sourceRef="get_balance" targetRef="cost_gateway">
        <bpmn:documentation>余额是否大于0</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="sub_account_end_gateway" name="sub_account_end_gateway">
        <bpmn:incoming>Flow_1rwqr7k</bpmn:incoming>
        <bpmn:incoming>Flow_195m52i</bpmn:incoming>
        <bpmn:outgoing>Flow_1fix1zc</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_1rwqr7k" sourceRef="cost" targetRef="sub_account_end_gateway" />
      <bpmn:sequenceFlow id="Flow_1fix1zc" sourceRef="sub_account_end_gateway" targetRef="Event_1t5zntg" />
      <bpmn:inclusiveGateway id="cost_gateway" name="cost_gateway">
        <bpmn:incoming>Flow_0j5z51w</bpmn:incoming>
        <bpmn:outgoing>Flow_1rxsr4o</bpmn:outgoing>
        <bpmn:outgoing>Flow_1518o56</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:sequenceFlow id="Flow_195m52i" sourceRef="deposit" targetRef="sub_account_end_gateway" />
    </bpmn:subProcess>
    <bpmn:callActivity id="call_sub_account" name="sub_account" calledElement="sub_account">
      <bpmn:documentation>账户操作 子流程</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="timeout" value="2000" />
          <camunda:property name="strict-mode" value="true" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1pj3bp4</bpmn:incoming>
      <bpmn:outgoing>Flow_11akgq2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1pj3bp4" sourceRef="asyncGateway" targetRef="call_sub_account" />
    <bpmn:sequenceFlow id="Flow_11akgq2" sourceRef="call_sub_account" targetRef="response" />
  </bpmn:process>
