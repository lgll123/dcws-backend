<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.formssi.workflow.mapper.DcwsHisMapper">

    <update id="updateByTaskId" parameterType="com.formssi.workflow.domain.DcwsHis">
        UPDATE dcws_common_approve_his
        <set>
            <if test="comment != null" >
                comment=#{comment},
            </if>
        </set>
        update_time = sysdate
        WHERE task_id = #{taskId} and user_Id = #{userId}
    </update>

</mapper>
