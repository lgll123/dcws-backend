                        <bpmn:camunda:property name="task-service" value="rest-service"/>
                        <bpmn:camunda:property name="task-component" value="KstryFlowService"/>
                        <bpmn:camunda:property name="task-params" value="{&#10;    &quot;request&quot;: {&#10;        &quot;url&quot;: &quot;http://localhost:8888/user/page&quot;,&#10;        &quot;method&quot;: &quot;GET&quot;,&#10;        &quot;params&quot;: {&#10;            &quot;size&quot;: 5,&#10;            &quot;number&quot;: 1&#10;        }&#10;    },&#10;    &quot;config&quot;: {&#10;        &quot;id&quot;: &quot;page&quot;&#10;    }&#10;}"/>
                    </bpmn:camunda:properties>
                </bpmn:extensionElements>
            </bpmn:serviceTask>
            <bpmn:exclusiveGateway gatewayDirection="Unspecified" id="isAdminGateway" name="isAdminGateway">
                <bpmn:documentation id="isAdminGateway_D_1"><![CDATA[判断是否管理员的网关]]></bpmn:documentation>
            </bpmn:exclusiveGateway>
            <bpmn:serviceTask activiti:exclusive="true" id="get" name="get">
                <bpmn:documentation id="get_D_1"><![CDATA[返回用户信息]]></bpmn:documentation>
                <bpmn:extensionElements>
                    <bpmn:camunda:properties>
                        <bpmn:camunda:property name="task-service" value="rest-service"/>
                        <bpmn:camunda:property name="task-params" value="{&#10;    &quot;request&quot;: {&#10;        &quot;url&quot;: &quot;http://localhost:8888/user/get&quot;,&#10;        &quot;method&quot;: &quot;GET&quot;,&#10;        &quot;params&quot;: {&#10;            &quot;id&quot;: &quot;@var.verify.response.data.id&quot;&#10;        }&#10;    },&#10;    &quot;config&quot;: {&#10;        &quot;id&quot;: &quot;get&quot;,&#10;    }&#10;}"/>
                        <bpmn:camunda:property name="task-component" value="KstryFlowService"/>
                    </bpmn:camunda:properties>
                </bpmn:extensionElements>
            </bpmn:serviceTask>
            <bpmn:sequenceFlow id="Flow_06cg7cq" sourceRef="isAdminGateway" targetRef="page">
                <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[var.isAdmin.response.data==true]]></bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Flow_0e7xxn5" sourceRef="isAdminGateway" targetRef="get">
                <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[var.isAdmin.response.data==false]]></bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Flow_0q97q85" sourceRef="Event_1sq263k" targetRef="isAdmin"/>
            <bpmn:sequenceFlow id="Flow_0vkipnp" sourceRef="isAdmin" targetRef="isAdminGateway"/>
            <bpmn:endEvent id="Event_1820r37" name="end">
                <bpmn:documentation id="Event_1820r37_D_1"><![CDATA[sub_user_info 结束]]></bpmn:documentation>
